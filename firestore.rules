rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: full access if authenticated + isAdmin claim
    match /{document=**} {
      allow read, write: if request.auth != null 
                         && request.auth.token.isAdmin == true;
    }

    // Public: can create enquiries only
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if false; // admin only via above rule
    }

    // Public: can read active services only
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true;
    }

    // Public: no direct access to orders
    // Orders are read securely via POST /api/track-order/verify-otp
    match /orders/{orderId} {
      allow read, write: if false; 
    }
    
    // Payments: no public access
    match /payments/{paymentId} {
      allow read, write: if false;
    }
    
    // Customers: no public access
    match /customers/{customerId} {
      allow read, write: if false;
    }
  }
}
